{
  "name": "simple-express",
  "version": "1.0.0",
  "description": "A step-by-step Node.js, Express, and MySQL learning project",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "private": true,
  "dependencies": {
    "express": "^5.3.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
